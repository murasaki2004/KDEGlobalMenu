#: package/contents/ui/main.qml:51
msgid "KDEGlobalMenu"
msgstr "KDEGlobalMenu"

#: package/contents/ui/MenuPopup.qml:81
msgctxt "Open the KDE About System information page"
msgid "About This Computer"
msgstr "关于本机"

#: package/contents/ui/MenuPopup.qml:82
msgctxt "Open the KDE system settings application"
msgid "System Settings"
msgstr "系统设置"

#: package/contents/ui/MenuPopup.qml:83
msgctxt "Submenu listing recently used applications"
msgid "Recent Items"
msgstr "最近使用的项目"

#: package/contents/ui/MenuPopup.qml:84
msgctxt "Power action: put the computer to sleep (suspend)"
msgid "Sleep"
msgstr "睡眠"

#: package/contents/ui/MenuPopup.qml:85
msgctxt "Power action: reboot the computer"
msgid "Restart"
msgstr "重新启动"

#: package/contents/ui/MenuPopup.qml:86
msgctxt "Power action: power off the computer"
msgid "Shut Down"
msgstr "关机"

#: package/contents/ui/MenuPopup.qml:87
msgctxt "Power action: lock the screen immediately"
msgid "Lock Screen"
msgstr "锁定屏幕"

#: package/contents/ui/MenuPopup.qml:88
msgctxt "Power action: end the current session"
msgid "Log Out"
msgstr "退出登录"

#: package/contents/ui/MenuPopup.qml:160
msgctxt "Go back from the Recent Items submenu to the main menu"
msgid "Back"
msgstr "返回"

#: package/contents/ui/MenuPopup.qml:205
msgid "Recent items unavailable"
msgstr "无法获取最近使用的项目"

#: package/contents/ui/MenuPopup.qml:208
msgid "No recent applications"
msgstr "暂无最近使用的程序"

#: package/contents/ui/MenuPopup.qml:209
msgctxt "Placeholder while the recent items list is being read"
msgid "Loading…"
msgstr "正在加载…"

#: package/contents/ui/config_general.qml:97
msgid "Current icon:"
msgstr "当前图标："

#: package/contents/ui/config_general.qml:127
msgid "Icon chooser not found — run install.sh to build it"
msgstr "未找到图标选择器 —— 请运行 install.sh 编译"

#: package/contents/ui/config_general.qml:139
msgid "Choose icon:"
msgstr "选择图标："

#: package/contents/ui/config_general.qml:141
msgid "Browse Icons…"
msgstr "浏览图标…"

#: package/contents/ui/config_general.qml:149
msgid "Opens KDE's own icon picker dialog as used by Kate and Dolphin."
msgstr "打开 KDE 自带的图标选择对话框（与 Kate、Dolphin 使用的是同一个）。"

#: package/contents/ui/config_general.qml:158
msgctxt "Reset the icon back to its default value"
msgid "Reset"
msgstr "恢复默认"

#: package/contents/ui/config_general.qml:166
msgid "Or enter an icon name:"
msgstr "或直接输入图标名："

#: package/contents/ui/config_general.qml:176
msgid "Recent items shown:"
msgstr "最近项目显示条数："

#: package/contents/config/config.qml:12
msgctxt "Name of the configuration category"
msgid "Appearance"
msgstr "外观"
